{
  "name": "atelier-mod-manager",
  "version": "1.1.0",
  "description": "Desktop mod manager for Lobotomy Corporation and Library of Ruina",
  "main": "electron/main.js",
  "type": "commonjs",
  "packageManager": "pnpm@11.5.3",
  "homepage": "https://github.com/Rowrow620/altelier#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rowrow620/altelier.git"
  },
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -s first \"pnpm run dev:vite\" \"pnpm run dev:electron\"",
    "build": "vite build",
    "build:plugins": "dotnet build -c Release -o electron/tweaks/ruina/Assemblies plugins/ruina/AtelierTweaks.csproj && dotnet build -c Release -o electron/tweaks/lobotomy plugins/lobotomy/AtelierLobotomyTweaks.csproj",
    "test": "node --test",
    "check": "tsc --noEmit && pnpm test && pnpm build",
    "package:dir": "pnpm build && electron-builder --win --dir",
    "package:win": "pnpm build && electron-builder --win",
    "start": "electron .",
    "debug": "electron . --atelier-debug"
  },
  "keywords": [
    "lobotomy-corporation",
    "library-of-ruina",
    "project-moon",
    "mod-manager",
    "atelier"
  ],
  "author": "Juan F. Sanchez Jr.",
  "license": "Apache-2.0",
  "build": {
    "appId": "com.rowrow620.atelier",
    "productName": "Atelier Mod Manager",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/default-config.json",
      "src/assets/app-icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false,
      "multiLanguageInstaller": false,
      "packElevateHelper": false
    }
  },
  "dependencies": {
    "adm-zip": "0.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "clsx": "2.1.1",
    "concurrently": "10.0.7",
    "cross-env": "^10.1.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "wait-on": "9.5.1"
  }
}
